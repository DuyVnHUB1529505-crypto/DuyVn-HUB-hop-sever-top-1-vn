-- HOP SERVER ĐÚNG 1 NGƯỜI
Hop.MouseButton1Click:Connect(function()

    Status.Text = "🔎 Đang tìm server 1 người..."

    task.spawn(function()

        local cursor = ""
        local found = {}

        for page = 1,5 do

            local url =
                "https://games.roblox.com/v1/games/"
                .. PlaceId
                .. "/servers/Public?sortOrder=Asc&limit=100"

            if cursor ~= "" then
                url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
            end

            local ok,data = pcall(function()
                return game:HttpGet(url)
            end)

            if not ok then
                Status.Text = "❌ Không lấy được server"
                return
            end

            local ok2,result = pcall(function()
                return HttpService:JSONDecode(data)
            end)

            if not ok2 or not result then
                Status.Text = "❌ Lỗi dữ liệu server"
                return
            end

            for _,server in ipairs(result.data or {}) do

                if server.id ~= game.JobId
                and server.playing == 1
                and server.playing < server.maxPlayers then

                    table.insert(found,server)
                end
            end

            if #found > 0 then
                break
            end

            cursor = result.nextPageCursor or ""

            if cursor == "" then
                break
            end
        end

        if #found == 0 then
            Status.Text = "⚠️ Không có server đúng 1 người"
            return
        end

        local target = found[math.random(1,#found)]

        Status.Text = "🚀 Đang hop server 1 người..."

        task.wait(0.5)

        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                target.id,
                Player
            )
        end)
    end)
end)

-- EXTREME LOW GRAPHICS
local graphicsOn = false

local function ExtremeGraphics()

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 0
        Lighting.FogEnd = 1000000
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.Technology = Enum.Technology.Compatibility
    end)

    for _,v in ipairs(Lighting:GetDescendants()) do
        pcall(function()

            if v:IsA("PostEffect")
            or v:IsA("Atmosphere")
            or v:IsA("Clouds") then

                v.Enabled = false
            end
        end)
    end

    for _,v in ipairs(Workspace:GetDescendants()) do
        pcall(function()

            if v:IsA("ParticleEmitter")
            or v:IsA("Trail")
            or v:IsA("Beam")
            or v:IsA("Smoke")
            or v:IsA("Fire")
            or v:IsA("Sparkles") then

                v.Enabled = false
            end

            if v:IsA("BasePart") then
                v.CastShadow = false
                v.Reflectance = 0
                v.Material = Enum.Material.Plastic
            end

            if v:IsA("Decal")
            or v:IsA("Texture") then

                v.Transparency = 1
            end

            if v:IsA("SurfaceAppearance") then
                v:Destroy()
            end

            if v:IsA("MeshPart") then
                v.RenderFidelity = Enum.RenderFidelity.Performance
            end
        end)
    end

    pcall(function()
        local Terrain = Workspace:FindFirstChildOfClass("Terrain")

        if Terrain then
            Terrain.Decoration = false
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveSpeed = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 1
        end
    end)

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    pcall(function()
        settings().Rendering.MeshPartDetailLevel =
            Enum.MeshPartDetailLevel.Level01
    end)
end

Gfx.MouseButton1Click:Connect(function()

    graphicsOn = not graphicsOn

    if graphicsOn then

        ExtremeGraphics()

        Gfx.Text = "⛏️ GRAPHICS CỰC THẤP: ON"
        Status.Text = "⚡ Đã giảm đồ họa cực mạnh"

    else

        Gfx.Text = "⛏️ GRAPHICS CỰC THẤP: OFF"
        Status.Text = "Graphics cực thấp đang tắt"
    end
end)

-- GIỮ GRAPHICS THẤP CHO OBJECT MỚI
Workspace.DescendantAdded:Connect(function(v)

    if not graphicsOn then
        return
    end

    task.defer(function()

        pcall(function()

            if v:IsA("ParticleEmitter")
            or v:IsA("Trail")
            or v:IsA("Beam")
            or v:IsA("Smoke")
            or v:IsA("Fire")
            or v:IsA("Sparkles") then

                v.Enabled = false

            elseif v:IsA("BasePart") then

                v.CastShadow = false
                v.Reflectance = 0
                v.Material = Enum.Material.Plastic

            elseif v:IsA("Decal")
            or v:IsA("Texture") then

                v.Transparency = 1
            end
        end)
    end)
end)

